{"schema_version":1,"locale":"zh-TW","review_status":"draft-human-review-required","translation_method":"machine-assisted-draft-with-stablekey-human-overrides","entries":{"srd5.1:ability:cha":{"name":"魅力"},"srd5.1:ability:con":{"name":"體質"},"srd5.1:ability:dex":{"name":"敏捷"},"srd5.1:ability:int":{"name":"智力"},"srd5.1:ability:str":{"name":"力量"},"srd5.1:ability:wis":{"name":"睿知"},"srd5.1:alignment:chaotic-evil":{"name":"混亂邪惡"},"srd5.1:alignment:chaotic-good":{"name":"混亂善良"},"srd5.1:alignment:chaotic-neutral":{"name":"混亂中立"},"srd5.1:alignment:lawful-evil":{"name":"守序邪惡"},"srd5.1:alignment:lawful-good":{"name":"守序善良"},"srd5.1:alignment:lawful-neutral":{"name":"守序中立"},"srd5.1:alignment:neutral":{"name":"絕對中立"},"srd5.1:alignment:neutral-evil":{"name":"中立邪惡"},"srd5.1:alignment:neutral-good":{"name":"中立善良"},"srd5.1:background:acolyte":{"name":"侍僧","data.feature.name":"信徒庇護","data.roleplay_suggestions.personality_traits.0":"我崇拜信仰中的某位英雄，經常引用其事蹟與榜樣。","data.roleplay_suggestions.personality_traits.1":"即使面對最激烈的敵對雙方，我也能找到共同點、理解彼此並努力促成和平。","data.roleplay_suggestions.personality_traits.2":"我從每件事與每個行動中看見預兆；諸神一直試著對我們說話，我們只需要傾聽。","data.roleplay_suggestions.personality_traits.3":"沒有任何事能動搖我的樂觀態度。","data.roleplay_suggestions.personality_traits.4":"幾乎在任何場合，我都會引用（或錯引）聖典與箴言。","data.roleplay_suggestions.personality_traits.5":"我對其他信仰抱持寬容（或不寬容）的態度，並尊重（或譴責）對其他神祇的崇拜。","data.roleplay_suggestions.personality_traits.6":"我曾在神殿菁英之間享受美食、美酒與上流社交，因此粗糙的生活令我難受。","data.roleplay_suggestions.personality_traits.7":"我在神殿生活太久，幾乎沒有與外界人士打交道的實際經驗。","data.roleplay_suggestions.ideals.0":"傳統。古老的崇拜與祭祀傳統必須被保存並維護。","data.roleplay_suggestions.ideals.1":"慈善。無論個人要付出什麼代價，我總會努力幫助有需要的人。","data.roleplay_suggestions.ideals.2":"改變。我們必須協助促成諸神持續在世界中推動的變化。","data.roleplay_suggestions.ideals.3":"權力。我希望有一天能登上自己信仰體系的最高位置。","data.roleplay_suggestions.ideals.4":"信念。我相信神祇會引導我的行動，也相信只要努力，事情終將順利。","data.roleplay_suggestions.ideals.5":"志向。我努力讓自己的行動符合神祇教誨，以證明自己值得獲得恩寵。","data.roleplay_suggestions.bonds.0":"為了找回信仰中失落已久的古老聖物，我願意付出生命。","data.roleplay_suggestions.bonds.1":"總有一天，我會向那群把我打成異端的腐敗神殿高層復仇。","data.roleplay_suggestions.bonds.2":"父母過世後收留我的祭司救了我一命，我欠他一份恩情。","data.roleplay_suggestions.bonds.3":"我所做的一切都是為了平民百姓。","data.roleplay_suggestions.bonds.4":"為了保護我曾侍奉的神殿，我願意做任何事。","data.roleplay_suggestions.bonds.5":"我努力保存一部敵人視為異端並想摧毀的聖典。","data.roleplay_suggestions.flaws.0":"我嚴厲評斷他人，對自己更是如此。","data.roleplay_suggestions.flaws.1":"我過度信任神殿體系中掌握權力的人。","data.roleplay_suggestions.flaws.2":"我的虔誠有時會讓我盲目信任自稱信奉我神祇的人。","data.roleplay_suggestions.flaws.3":"我的思考方式很僵化。","data.roleplay_suggestions.flaws.4":"我對陌生人抱持懷疑，並總預期他們會做出最糟的事。","data.roleplay_suggestions.flaws.5":"一旦選定目標，我就會執著其中，甚至犧牲生活中的其他一切。"},"srd5.1:class:barbarian":{"name":"野蠻人"},"srd5.1:class:bard":{"name":"吟遊詩人"},"srd5.1:class:cleric":{"name":"牧師"},"srd5.1:class:druid":{"name":"德魯伊"},"srd5.1:class:fighter":{"name":"戰士"},"srd5.1:class:monk":{"name":"武僧"},"srd5.1:class:paladin":{"name":"聖武士"},"srd5.1:class:ranger":{"name":"遊俠"},"srd5.1:class:rogue":{"name":"遊蕩者"},"srd5.1:class:sorcerer":{"name":"術士"},"srd5.1:class:warlock":{"name":"邪術師"},"srd5.1:class:wizard":{"name":"法師"},"srd5.1:condition:blinded":{"name":"目盲"},"srd5.1:condition:charmed":{"name":"魅惑"},"srd5.1:condition:deafened":{"name":"耳聾"},"srd5.1:condition:exhaustion":{"name":"力竭"},"srd5.1:condition:frightened":{"name":"恐慌"},"srd5.1:condition:grappled":{"name":"被擒抱"},"srd5.1:condition:incapacitated":{"name":"失能"},"srd5.1:condition:invisible":{"name":"隱形"},"srd5.1:condition:paralyzed":{"name":"麻痺"},"srd5.1:condition:petrified":{"name":"石化"},"srd5.1:condition:poisoned":{"name":"中毒"},"srd5.1:condition:prone":{"name":"倒地"},"srd5.1:condition:restrained":{"name":"束縛"},"srd5.1:condition:stunned":{"name":"震懾"},"srd5.1:condition:unconscious":{"name":"昏迷"},"srd5.1:damage-type:acid":{"name":"強酸"},"srd5.1:damage-type:bludgeoning":{"name":"鈍擊"},"srd5.1:damage-type:cold":{"name":"寒冷"},"srd5.1:damage-type:fire":{"name":"火焰"},"srd5.1:damage-type:force":{"name":"力場"},"srd5.1:damage-type:lightning":{"name":"閃電"},"srd5.1:damage-type