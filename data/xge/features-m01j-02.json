    "key": "xge:feature:swashbuckler-3-rakish-audacity",
    "index": "swashbuckler-3-rakish-audacity",
    "name": "Rakish Audacity",
    "source": "xge",
    "ruleset": "dnd5e-2014",
    "license": null,
    "provenance": {
      "type": "private-maintainer-normalization",
      "phase": "M01-J",
      "reference": "docs/暫用規則資訊/子職業_遊蕩者.md"
