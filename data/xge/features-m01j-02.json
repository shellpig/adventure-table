      "subclass": {
        "key": "xge:subclass:storm-sorcery",
        "name": "Storm Sorcery"
      },
      "reference_heading_zh": "風暴魔法",
      "reference_text_zh": "*1級暴風術法特性*\n\n緊接在你施放一個1環或更高環的法術之前或之後，你可以在你的回合使用一個附贈動作以使元素之氣形成的旋轉陣風短暫地環繞著你。這麼做讓你得以飛行最多10尺距離，而不會引發藉機攻擊。",
      "automation_boundary": "structured_manual"
    }
  },
