  {"key":"mtf:feature:blessing-of-the-raven-queen","index":"blessing-of-the-raven-queen","name":"Blessing of the Raven Queen","source":"mtf","ruleset":"dnd5e-2014","data":{"index":"blessing-of-the-raven-queen","name":"Blessing of the Raven Queen","desc":["As a bonus action, magically teleport up to 30 feet to an unoccupied space you can see once per long rest. Starting at 3rd level, after teleporting you gain resistance to all damage until the start of your next turn."],"resource":{"capacity":{"type":"fixed","value":1},"recharge":["long_rest"]},"level_3_effect":{"minimum_character_level":3,"damage_resistance":"all","duration":"until_start_of_next_turn"},"runtime_execution":"deferred_spatial"}},

