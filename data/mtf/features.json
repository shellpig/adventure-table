  {"key":"mtf:feature:duergar-magic","index":"duergar-magic","name":"Duergar Magic","source":"mtf","ruleset":"dnd5e-2014","data":{"index":"duergar-magic","name":"Duergar Magic","desc":["At 3rd level you can cast Enlarge/Reduce on yourself once per long rest; at 5th level you can cast Invisibility on yourself once per long rest. These racial castings require no components and cannot be used while you are in direct sunlight."],"racial_spell_access":[{"spell":{"key":"srd5.1:spell:enlarge-reduce","name":"Enlarge/Reduce"},"min_character_level":3,"uses_spell_slot":false,"uses_per_rest":1,"recharge_types":["long_rest"],"waive_components":["V","S","M"],"runtime_restrictions":["self_only","cannot_cast_in_direct_sunlight"]},{"spell":{"key":"srd5.1:spell:invisibility","name":"Invisibility"},"min_character_level":5,"uses_spell_slot":false,"uses_per_rest":1,"recharge_types":["long_rest"],"waive_components":["V","S","M"],"runtime_restrictions":["self_only","cannot_cast_in_direct_sunlight"]}],"runtime_execution":"automatic_static"}},
  {"key":"mtf:feature:duergar-sunlight-sensitivity","index":"duergar-sunlight-sensitivity","name":"Sunlight Sensitivity","source":"mtf","ruleset":"dnd5e-2014","data":{"index":"duergar-sunlight-sensitivity","name":"Sunlight Sensitivity","desc":["You have disadvantage on attack rolls and on Wisdom (Perception) checks that rely on sight when you or the target are in direct sunlight."],"runtime_execution":"deferred_roll"}},

  {"key":"mtf:feature:fey-step","index":"fey-step","name":"Fey Step","source":"mtf","ruleset":"dnd5e-2014","data":{"index":"fey-step","name":"Fey Step","desc":["As a bonus action, magically teleport up to 30 feet to an unoccupied space you can see. You regain this ability after a short or long rest."],"resource":{"capacity":{"type":"fixed","value":1},"recharge":["short_rest","long_rest"]},"runtime_execution":"deferred_spatial"}},
  {"key":"mtf:feature:eladrin-seasonal-aspect","index":"eladrin-seasonal-aspect","name":"Seasonal Aspect","source":"mtf","ruleset":"dnd5e-2014","data":{"index":"eladrin-seasonal-aspect","name":"Seasonal Aspect","desc":["Choose autumn, winter, spring, or summer. You can change season after a long rest. Starting at 3rd level, Fey Step gains the selected season's additional effect; target, save, charm, frighten, teleport-other, and fire-damage resolution remain manual until later combat systems."],"feature_mode":{"mode_key":"eladrin-season","options":["autumn","winter","spring","summer"],"default":"autumn","change_timing":"manual_after_long_rest"},"seasonal_effects":{"minimum_character_level":3,"autumn":"charm nearby creatures after teleport","winter":"frighten one nearby creature before teleport","spring":"teleport one willing creature instead of yourself","summer":"deal fire damage after teleport"},"runtime_execution":"manual"}},

